{% from "partials/macros.njk" import cover with context %}

<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">Mockup, not linked from the site</p>
    <h1>Cover concepts</h1>
    <p class="lede">Each two-in-one cover splits down the middle: Xavier’s Story in cream, Marcus’s Story in plum, each with its season and a window onto one object from that book. The objects are placeholders, replaced by each book’s real cover art when it is released.</p>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap">
    <h2 class="section-title">Book One and the two-in-ones</h2>
    <ul class="mockup-grid">
      <li>{{ cover(books.bookOne) }}</li>
      {%- for b in books.duo %}
      <li>{{ cover(b) }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section section--paper">
  <div class="wrap">
    <h2 class="section-title">Each life on its own</h2>
    <p>For ads, social posts and the ebook’s “Choose your life” page, each half can stand alone.</p>
    <ul class="mockup-grid mockup-grid--small">
      {%- for b in books.sides %}
      <li>{{ cover(b) }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="section-title">Thumbnail test</h2>
    <p>About the size most readers first see a cover on Amazon.</p>
    <ul class="mockup-grid mockup-grid--thumb">
      <li>{{ cover(books.bookOne) }}</li>
      {%- for b in books.duo %}
      <li>{{ cover(b) }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>
