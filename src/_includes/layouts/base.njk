{% from "partials/macros.njk" import logo with context %}
{%- set pageTitle = (title + " | " + site.brand) if title else (site.brand + " | SEASONS by " + site.author) -%}
{%- set pageDescription = description or site.description -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.brand }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-image.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#3D1C3E">
  <link rel="icon" href="/assets/img/brand/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/brand/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/cormorant-garamond-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/jost-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css?v={{ build.version }}">
  {%- if site.cloudflareAnalyticsToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareAnalyticsToken }}"}'></script>
  {%- endif %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="logo" href="/" aria-label="{{ site.brand }}, home">{{ logo("logo__img") }}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="nav-toggle__bars" aria-hidden="true"></span><span>Menu</span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="Main">
        <ul>
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
        <a class="btn btn--primary btn--sm" href="/letters/">Free prequel</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__grid">
      <div>
        <a class="logo logo--footer" href="/" aria-label="{{ site.brand }}, home">{{ logo("logo__img", "white") }}</a>
        <p class="site-footer__line">SEASONS, a novel series by {{ site.author }}, inspired by a true story.</p>
      </div>
      <nav aria-label="Footer">
        <h2 class="site-footer__heading">Explore</h2>
        <ul>
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor %}
          <li><a href="/media-kit/">Media kit</a></li>
        </ul>
      </nav>
      <div>
        <h2 class="site-footer__heading">Follow along</h2>
        <ul>
          {%- for s in site.social %}
          <li><a href="{{ s.url }}" rel="me noopener" target="_blank">{{ s.name }} <span class="muted">{{ s.handle }}</span></a></li>
          {%- endfor %}
          {%- if site.contactEmail %}
          <li><a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a></li>
          {%- endif %}
        </ul>
      </div>
    </div>
    <div class="wrap site-footer__base">
      <p>&copy; {{ build.year }} {{ site.author }}. All rights reserved.</p>
    </div>
  </footer>
  <script src="/assets/js/site.js?v={{ build.version }}" defer></script>
</body>
</html>
