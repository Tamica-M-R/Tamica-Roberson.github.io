{# The SHE FLUTTER logo. variant: "color" (light backgrounds) or "white" (dark backgrounds). #}
{% macro logo(cls="", variant="color", alt="") %}
{%- if variant == "white" -%}
<img class="logo-img {{ cls }}" src="/assets/img/brand/she-flutter-logo-white.png" width="873" height="725" alt="{{ alt }}">
{%- else -%}
<img class="logo-img {{ cls }}" src="/assets/img/brand/she-flutter-logo-color.png" width="830" height="740" alt="{{ alt }}">
{%- endif -%}
{% endmacro %}

{# A cover in the series template: a mockup until each book's real cover is released. #}
{# Two-in-one books (line "duo") split down the middle: Xavier's Story in cream on the left, #}
{# Marcus's Story in plum on the right, each with its season and a window onto one object. #}
{# The objects in the windows are placeholders for each book's real cover art. #}
{% macro cover(book, extra="") %}
{% from "partials/cover-art.njk" import art %}
{% set storyNames = { xavier: "Xavier’s Story", marcus: "Marcus’s Story" } %}
{% if book.line == "duo" %}
  {% set coverTitle = "Xavier’s Story, " + book.seasons.xavier + ", and Marcus’s Story, " + book.seasons.marcus %}
  {% set panels = [
    { side: "xavier", season: book.seasons.xavier, art: book.art.xavier, story: storyNames.xavier },
    { side: "marcus", season: book.seasons.marcus, art: book.art.marcus, story: storyNames.marcus }
  ] %}
{% elif book.line == "xavier" or book.line == "marcus" %}
  {% set coverTitle = storyNames[book.line] + ", " + book.season %}
  {% set panels = [{ side: book.line, season: book.season, art: book.art, story: storyNames[book.line] }] %}
{% else %}
  {% set coverTitle = book.title %}
  {% set panels = [{ side: book.line, season: "", art: book.art, story: book.title }] %}
{% endif %}
<div class="cover cover--{{ book.line }} {{ extra }}" role="img" aria-label="Cover: SEASONS, {{ book.label }}, {{ coverTitle }}, by Tamica M. Roberson">
  {%- for p in panels %}
  <div class="cover__panel cover__panel--{{ p.side }} season--{{ (p.season or book.season) | seasonKey }}">
    {%- if p.season %}
    <span class="cover__season">{{ p.season }}</span>
    {%- endif %}
    <span class="cover__window"><span class="cover__art">{{ art(p.art) }}</span></span>
    <span class="cover__story">{{ p.story }}</span>
  </div>
  {%- endfor %}
  {#- SEASONS, the book number and the author run across the whole cover. On a two-in-one
      each copy is clipped to one half, so the ink turns from plum to cream at the seam. #}
  {%- for p in panels %}
  <div class="cover__over cover__over--{{ p.side }}" aria-hidden="true">
    <span class="cover__series">SEASONS</span>
    <span class="cover__label">{{ book.label }}</span>
    <span class="cover__author">Tamica M. Roberson</span>
  </div>
  {%- endfor %}
</div>
{% endmacro %}

{# A row of travel snapshots. Photos and captions live in src/_data/places.js. #}
{% macro polaroids(list) %}
<div class="polaroids">
  {%- for p in list %}
  <figure class="polaroid">
    <img src="{{ p.src }}" width="640" height="853" alt="{{ p.alt }}" loading="lazy">
    <figcaption>{{ p.caption }}</figcaption>
  </figure>
  {%- endfor %}
</div>
{% endmacro %}

{# A YouTube video that loads only when someone presses play (site.js swaps in the player). #}
{# Until then it's a saved thumbnail, so the page doesn't contact YouTube. Without JavaScript it links to YouTube. #}
{% macro video(v, cls="") %}
<div class="video {{ cls }}">
  <a class="video__frame" href="https://www.youtube.com/watch?v={{ v.id }}" data-video="{{ v.id }}" data-title="{{ v.title }}" target="_blank" rel="noopener">
    {%- if v.thumb %}
    <img src="{{ v.thumb }}" alt="" loading="lazy">
    {%- endif %}
    <span class="video__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 6.5v11l9-5.5z" fill="currentColor"/></svg></span>
    <span class="visually-hidden">Play: {{ v.title }}</span>
  </a>
</div>
{% endmacro %}

{# The YouTube subscribe button. #}
{% macro subscribe(cls="btn--primary") %}
<a class="btn {{ cls }} btn--youtube" href="{{ youtube.subscribeUrl }}" target="_blank" rel="noopener"><svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3z"/></svg>Subscribe on YouTube</a>
{% endmacro %}

{# Email signup. Posts to Kit once site.kitFormAction is set; until then it shows a friendly note and sends nothing. #}
{% macro signup(id, cta="Send me Book One", dark=false) %}
<form class="signup{% if dark %} signup--dark{% endif %}" action="{{ site.kitFormAction or '#' }}" method="post" data-signup="{{ 'live' if site.kitFormAction else 'pending' }}">
  <div class="signup__row">
    <label class="visually-hidden" for="email-{{ id }}">Email address</label>
    <input id="email-{{ id }}" type="email" name="email_address" required placeholder="Your email address" autocomplete="email">
    <button class="btn btn--primary" type="submit">{{ cta }}</button>
  </div>
  <p class="signup__note">Free. A letter every other week. Unsubscribe anytime. <a href="/privacy/">Privacy</a></p>
  <p class="signup__status" role="status" aria-live="polite"></p>
</form>
{% endmacro %}
